generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String  @id
  name             String?
  username         String  @unique
  password         String
  role             String?
  canManageReturns Boolean?
  permissions      UserPermission[]
}

// صلاحيات دقيقة لكل مستخدم: صف واحد لكل زوج (module, action) مسموح بيه. الحفظ
// دايمًا delete-all-for-user ثم recreate للمجموعة الجديدة (نفس أسلوب
// upsertPartnerLedger)، فمفيش داعي لـ @@unique. onDelete:Cascade لأنها ملكية
// حقيقية للمستخدم (زي Product/ProductVariant) مش مرجع مالي تاريخي محتاج يفضل
// موجود بعد حذف صاحبه (زي Debt/DebtPayment).
model UserPermission {
  id     String @id
  userId String
  module String // "products" | "orders" | ... (نفس ids الموجودة في nav بالواجهة)
  action String // "view" | "create" | "edit" | "delete" | "print" | "collect" | "cancel" | "return" | "exchange" | "payment"
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id   String @id
  name String @unique
}

model Product {
  id        String  @id
  name      String
  category  String?
  price     Float?
  cost      Float?
  stock     Int?
  sku       String?
  modelCode String?
  image     String?
  offer     String?
  emoji     String?
  data      Json?
  variants  ProductVariant[]
}

model ProductVariant {
  id        String  @id
  productId String
  size      String?
  color     String?
  stock     Int?
  barcode   String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// أمر طباعة — تحويل مخزون داخلي بحت بين موديلين (مثلاً قطعة "سادة" إلى نفس
// القطعة "مطبوعة"): خصم من موديل مصدر وإضافة لموديل ناتج بنفس الكمية بالظبط.
// لا علاقة له بالمبيعات/المشتريات ولا بأي حساب شريك أو عميل — مرجع نصي بسيط
// لـ Product/ProductVariant (بدون FK) بنفس مبدأ PurchaseItem، عشان لو الموديل
// اتعدّل أو اتحذف لاحقًا يفضل سجل أمر الطباعة التاريخي موجود وقابل للقراءة.
model PrintingOrder {
  id                String    @id
  orderNumber       String?
  date              DateTime?
  sourceProductId   String?
  sourceVariantId   String?
  sourceModelCode   String?
  sourceProductName String?
  sourceColor       String?
  sourceSize        String?
  targetProductId   String?
  targetVariantId   String?
  targetModelCode   String?
  targetProductName String?
  targetColor       String?
  targetSize        String?
  quantity          Int?
  status            String?   // "منفذ" | "ملغي"
  notes             String?
  userId            String?
  cancelledAt       DateTime?
  cancelledBy       String?
  createdAt         DateTime?
  updatedAt         DateTime?
  data              Json?
}

model Customer {
  id        String @id
  name      String
  phone     String?
  notes     String?
  createdAt DateTime?
  addresses Json?
}

model Supplier {
  id    String @id
  name  String
  phone String?
  notes String?
}

model Purchase {
  id         String @id
  number     String?
  date       DateTime?
  userId     String?
  supplierId String?
  supplierName String?
  total      Float?
  type       String?  // "goods" | "financial" — financial invoices carry no items and never touch stock
  paid       Float?
  remaining  Float?
  paymentStatus String? // "paid" | "partial" | "unpaid"
  paymentMethod String?
  notes      String?
  data       Json?
  items      PurchaseItem[]
  payments   PurchasePayment[]
}

model PurchaseItem {
  id         String @id
  purchaseId String
  productId  String?
  variantId  String?
  qty        Int?
  cost       Float?
  data       Json?
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

// دفعة على فاتورة شراء محددة (بضاعة أو مالية) — منفصلة عن PaymentOut اللي هي
// دفعة إجمالية للمورد مش مربوطة بفاتورة بعينها. لا يوجد onDelete:Cascade هنا
// عمداً حتى لا يُحذف مرجع الفاتورة الأصلية وتحتها دفعات مسجّلة (نفس مبدأ
// SaleReturn → Sale).
model PurchasePayment {
  id           String @id
  purchaseId   String
  supplierId   String?
  supplierName String?
  date         DateTime?
  amount       Float?
  paymentMethod String?
  notes        String?
  userId       String?
  partner      String? // "moamen" | "abdo"
  data         Json?
  purchase     Purchase @relation(fields: [purchaseId], references: [id])
}

// نظام حسابات أشخاص مستقل للديون: حساب واحد لكل اسم شخص (DebtAccount)، تحته أي
// عدد من الفواتير (Debt)، وتحت كل فاتورة أو الحساب مباشرة أي عدد من الدفعات
// (DebtPayment). مفيش نوع دين ولا اعتماد على Customer/Supplier — الاسم نفسه هو
// مفتاح الحساب. الإجماليات دايمًا بتتحسب حية من SUM على الفواتير/الدفعات (نفس
// مبدأ recomputeDebtTotals) — مفيش رقم متراكم مخزّن يقدر يعمل drift.
model DebtAccount {
  id        String    @id
  name      String // اسم الشخص — البحث عن حساب مطابق بيتم على الاسم بعد trim
  notes     String?
  userId    String?
  createdAt DateTime?
  data      Json?
  debts     Debt[]
  payments  DebtPayment[]
}

model Debt {
  id            String @id
  accountId     String? // NEW — يشير لحساب الشخص المالك للفاتورة دي (null مؤقتًا لحد ما الترحيل التلقائي يشتغل على السجلات القديمة)
  number        String? // NEW — رقم الفاتورة (إدخال يدوي، من فورم "إضافة فاتورة" فقط)
  type          String? // legacy — مش بيتكتب من الكود الجديد، محتفظ بيه لبيانات قديمة فقط
  entityType    String? // legacy // "customer" | "supplier" | "partner" | "person" | "other"
  entityId      String? // legacy
  personName    String? // نسخة من اسم الحساب وقت إنشاء الفاتورة
  totalAmount   Float?
  paidAmount    Float?
  remainingAmount Float?
  status        String? // "unpaid" | "partial" | "paid"
  date          DateTime?
  paymentMethod String?
  notes         String?
  partner       String? // "moamen" | "abdo" — الحساب اللي استلم الدفعة المبدئية لهذه الفاتورة (لو فيه)
  direction     String? // legacy — الفواتير الجديدة دايمًا فعليًا "in"
  userId        String?
  data          Json?
  account       DebtAccount? @relation(fields: [accountId], references: [id])
  payments      DebtPayment[]
}

model DebtPayment {
  id            String @id
  accountId     String? // NEW — دايمًا موجود في أي دفعة جديدة (دفعة عامة أو مرتبطة بفاتورة)
  debtId        String? // بقت اختيارية — فاضية لو دفعة عامة على الحساب مش مرتبطة بفاتورة بعينها
  amount        Float?
  date          DateTime? // payment date
  paymentMethod String?
  notes         String?
  partner       String? // "moamen" | "abdo" — إلزامي لأي دفعة جديدة؛ الحساب اللي استلم الفلوس فعليًا
  payerType     String? // legacy // "partner" | "customer"
  payerId       String? // legacy
  payerName     String? // legacy
  direction     String? // الدفعات الجديدة دايمًا "in" (فلوس بتتحصّل من الشخص)
  userId        String? // "بواسطة" — المستخدم اللي سجّل الدفعة
  createdAt     DateTime?
  updatedAt     DateTime?
  data          Json?
  account       DebtAccount? @relation(fields: [accountId], references: [id])
  debt          Debt? @relation(fields: [debtId], references: [id])
}

model Sale {
  id      String @id
  number  String?
  date    DateTime?
  userId  String?
  total   Float?
  data    Json?
  items   SaleItem[]
  returns SaleReturn[]
}

model SaleItem {
  id      String @id
  saleId  String
  productId String?
  variantId String?
  price   Float?
  qty     Int?
  size    String?
  color   String?
  data    Json?
  sale    Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  returnItems SaleReturnItem[]
}

// معاملة استرجاع أو استبدال — دايمًا مرتبطة بفاتورة بيع أصلية، والفاتورة الأصلية
// لا تُحذف ولا تُعدَّل أبدًا. راجع server.js: POST /api/returns
model SaleReturn {
  id               String   @id
  number           String?
  type             String?  // "return" | "exchange"
  saleId           String
  customerId       String?
  userId           String?
  date             DateTime?
  reason           String?
  status           String?
  refundMethod     String?  // "cash" | "credit"
  returnedTotal    Float?
  replacementTotal Float?
  difference       Float?
  data             Json?
  sale             Sale @relation(fields: [saleId], references: [id])
  items            SaleReturnItem[]
}

model SaleReturnItem {
  id                   String @id
  saleReturnId         String
  saleItemId           String
  productId            String?
  variantId            String?
  modelCode            String?
  size                 String?
  color                String?
  qty                  Int?
  unitPrice            Float?
  lineTotal            Float?
  condition            String?
  replacementProductId String?
  replacementVariantId String?
  replacementQty       Int?
  replacementPrice     Float?
  data                 Json?
  saleReturn           SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem             SaleItem @relation(fields: [saleItemId], references: [id])
}

model ShippingCompany {
  id    String @id
  name  String
  phone String?
  notes String?
}

model ShippingPrice {
  id          String @id
  governorate String
  price       Float?
}

model Order {
  id       String @id
  number   String?
  date     DateTime?
  userId   String?
  customerName String?
  total    Float?
  status   String?
  deposit  Float?
  collectedTotal    Float?
  remaining         Float?
  collectionStatus  String? // "collected" | "pending"
  data     Json?
  items    OrderItem[]
  collections OrderCollection[]
  exchanges   OrderExchange[]
}

// دفعة تحصيل على طلب — إما العربون عند إنشاء الطلب (kind:"deposit"، دائمًا عبدو)
// أو تحصيل لاحق (kind:"collection"، الشريك يُختار يدويًا). لا يوجد onDelete:Cascade
// عمداً، بنفس مبدأ PurchasePayment → Purchase.
model OrderCollection {
  id            String @id
  orderId       String
  kind          String?  // "deposit" | "collection"
  amount        Float?
  date          DateTime?
  paymentMethod String?
  partner       String?  // "moamen" | "abdo"
  notes         String?
  userId        String?
  data          Json?
  order         Order @relation(fields: [orderId], references: [id])
}

// استبدال أوردر — نفس مبدأ SaleReturn/SaleReturnItem لكن للأوردرات (موديل منفصل
// عمدًا، مش نفس SaleReturn، لأن الأوردرات نظام مستقل بالكامل بعربون/تحصيلات/شركاء
// خاصة به لا علاقة لها بفواتير البيع). لا onDelete:Cascade على orderId (نفس مبدأ
// SaleReturn → Sale / PurchasePayment → Purchase).
model OrderExchange {
  id               String   @id
  orderId          String
  userId           String?
  date             DateTime?
  reason           String?
  returnedTotal    Float?
  replacementTotal Float?
  difference       Float?
  refundPartner    String?  // "moamen" | "abdo" — مطلوب فقط لو الاستبدال نتج عنه استرداد فعلي
  refundAmount     Float?
  data             Json?
  order            Order @relation(fields: [orderId], references: [id])
  items            OrderExchangeItem[]
}

model OrderExchangeItem {
  id                   String @id
  orderExchangeId      String
  orderItemId          String
  productId            String?
  variantId            String?
  size                 String?
  color                String?
  qty                  Int?
  unitPrice            Float?
  lineTotal            Float?
  replacementProductId String?
  replacementVariantId String?
  replacementQty       Int?
  replacementPrice     Float?
  data                 Json?
  orderExchange        OrderExchange @relation(fields: [orderExchangeId], references: [id], onDelete: Cascade)
}

// سجل موحّد لكل حركة مالية مرتبطة بأحد الشريكين (مؤمن/عبدو) — المصدر الوحيد
// لحساب رصيد كل شريك. referenceType/referenceId مرجع نصي بسيط (بدون FK) لأنه
// يشير لعدة جداول مختلفة (sale/order/purchase/expense/otherIncome/return).
model PartnerTransaction {
  id            String @id
  partner       String   // "moamen" | "abdo"
  type          String   // SALE, ORDER_DEPOSIT, ORDER_COLLECTION, PURCHASE_PAYMENT, EXPENSE, OTHER_INCOME, RETURN, EXCHANGE_ADJUSTMENT
  direction     String   // "in" | "out"
  amount        Float?
  referenceType String?
  referenceId   String?
  date          DateTime?
  userId        String?
  notes         String?
  data          Json?
}

model OrderItem {
  id       String @id
  orderId  String
  productId String?
  variantId String?
  qty      Int?
  price    Float?
  data     Json?
  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ExpenseCategory {
  id   String @id
  name String @unique
}

model Expense {
  id       String @id
  category String?
  amount   Float?
  date     DateTime?
  note     String?
  userId   String?
  partner  String? // "moamen" | "abdo"
  data     Json?
}

model OtherIncome {
  id     String @id
  note   String?
  amount Float?
  date   DateTime?
  userId String?
  partner String? // "moamen" | "abdo"
  data   Json?
}

model PaymentIn {
  id           String @id
  customerName String?
  amount       Float?
  date         DateTime?
  userId       String?
  data         Json?
}

model PaymentOut {
  id           String @id
  supplierName String?
  amount       Float?
  date         DateTime?
  userId       String?
  partner      String? // "moamen" | "abdo"
  data         Json?
}

model CashClosing {
  id     String @id
  userId String?
  day    String?
  date   DateTime?
  data   Json?
}

model Transfer {
  id     String @id
  fromId String?
  toId   String?
  amount Float?
  date   DateTime?
  byId   String?
}

model AuditLog {
  id      String @id
  date    DateTime?
  userId  String?
  userName String?
  action  String?
  detail  String?
}

model Setting {
  id          String @id
  storeName    String?
  currency     String?
  taxRate      Float?
  lowStockThreshold Int?
  invoicePrefix String?
  invoiceCounter Int?
  purchaseCounter Int?
  orderCounter Int?
  returnCounter Int?
  printingOrderCounter Int?
  receiptFooter String?
  phone        String?
  data         Json?
}

model RawState {
  id   String @id
  data Json
}
