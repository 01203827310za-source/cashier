{
  "name": "clothing-pos",
  "version": "2.0.0",
  "description": "سيستم كاشير وإدارة متكامل لمحل ملابس مع شحن",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npx prisma@5.22.0 generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:backfill-model-code": "node prisma/backfill_model_code.js",
    "db:backfill-purchase-status": "node prisma/backfill_purchase_payment_status.js",
    "db:backfill-partner-sales": "node prisma/backfill_partner_sales.js",
    "migrate:from-json": "node prisma/migrate_from_json.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "prisma": "5.22.0"
  }
}
